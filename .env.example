# Web3Forms access key — https://web3forms.com
#
# Create a key using sarfrazsafiullah3@gmail.com. Submissions are delivered
# to that verified address and nowhere else, which is why this value is safe
# to expose in a static bundle. It must be NEXT_PUBLIC_* because `output:
# 'export'` inlines it at build time; there is no server to read it at runtime.
#
# CI: add the same value as a repository secret named NEXT_PUBLIC_WEB3FORMS_KEY.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Cloudflare Web Analytics token (optional).
# dash.cloudflare.com -> Analytics & Logs -> Web Analytics -> Add a site.
# Enter msafiullah1.github.io; Cloudflare returns a token. The site does not
# need to be proxied through Cloudflare for this to work.
#
# Cookieless and aggregate-only, so no consent banner is required. The beacon
# is skipped entirely in development and when this value is unset.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
